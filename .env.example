# ============================================
# 博客系统环境变量模板
# 复制此文件为 .env.local 并填入你的配置
# cp .env.example .env.local
# ============================================

# ---- 必填: Claude AI API ----
# 获取: https://console.anthropic.com/account/keys
# 阿里内部可用代理: https://1688openai.alibaba-inc.com/api/anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
CHAT_MODEL=claude-sonnet-4-6

# ---- 必填: Embedding API (RAG 向量搜索) ----
# 获取: https://modelscope.cn → API Inference → 获取 Token
# 也支持任何 OpenAI 兼容的 Embedding 服务
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_API_BASE=https://api-inference.modelscope.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ---- 可选: 个人笔记目录 ----
# 支持多目录，逗号分隔，~ 自动展开
NOTES_DIRS=~/notes

# ---- 可选: Supabase (评论 + 聊天记录持久化) ----
# 获取: https://supabase.com → New Project → Settings → API
# 数据库 Schema: 执行 supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 可选: Groq Whisper API (B站视频转录) ----
# 获取: https://console.groq.com → API Keys
GROQ_API_KEY=
