<?xml version="1.0" encoding="UTF-8"?>
<mxfile>

  <!-- ========== 图1: 向量召回算法全景图 ========== -->
  <diagram name="01-算法全景图">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="向量召回算法全景图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="50" as="geometry"/>
        </mxCell>

        <!-- 根节点: 向量召回 -->
        <mxCell id="root" value="向量召回算法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#1a1a2e;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="240" height="55" as="geometry"/>
        </mxCell>

        <!-- 一级分类: 精确搜索 -->
        <mxCell id="cat_exact" value="① 精确搜索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e74c3c;strokeColor=#c0392b;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 一级分类: 图索引 -->
        <mxCell id="cat_graph" value="② 图索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2980b9;strokeColor=#1a6fa0;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 一级分类: 树索引 -->
        <mxCell id="cat_tree" value="③ 树索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27ae60;strokeColor=#1e8449;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 一级分类: 哈希 -->
        <mxCell id="cat_hash" value="④ 哈希索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e44ad;strokeColor=#7d3c98;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 一级分类: 量化 -->
        <mxCell id="cat_quant" value="⑤ 向量量化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e67e22;strokeColor=#ca6f1e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="220" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 连接根节点到一级分类 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="root" target="cat_exact" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="root" target="cat_graph" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="root" target="cat_tree" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="root" target="cat_hash" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="root" target="cat_quant" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 精确搜索子项 -->
        <mxCell id="flat" value="Flat (暴力搜索)&#xa;精度100% | O(n·d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="360" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e_flat" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="cat_exact" target="flat" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 图索引子项 -->
        <mxCell id="hnsw" value="HNSW ⭐&#xa;最主流，精度高，内存大" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="340" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="nsg" value="NSG&#xa;省内存，工程复杂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="400" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="diskann" value="DiskANN (微软) ⭐&#xa;SSD友好，十亿级别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_hnsw" edge="1" source="cat_graph" target="hnsw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_nsg" edge="1" source="cat_graph" target="nsg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_diskann" edge="1" source="cat_graph" target="diskann" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 树索引子项 -->
        <mxCell id="kdtree" value="KD-Tree&#xa;低维有效(&lt;20维)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="340" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="balltree" value="Ball-Tree&#xa;稍优KD-Tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="400" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="annoy" value="Annoy (Spotify)&#xa;随机投影树，只读场景" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="460" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_kdtree" edge="1" source="cat_tree" target="kdtree" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_balltree" edge="1" source="cat_tree" target="balltree" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_annoy" edge="1" source="cat_tree" target="annoy" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 哈希子项 -->
        <mxCell id="lsh" value="LSH&#xa;局部敏感哈希，早期经典" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#8e44ad;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="simhash" value="SimHash&#xa;文本去重，Hamming距离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#8e44ad;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="400" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_lsh" edge="1" source="cat_hash" target="lsh" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_simhash" edge="1" source="cat_hash" target="simhash" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 量化子项 -->
        <mxCell id="pq" value="PQ 乘积量化 ⭐&#xa;Faiss核心，超省内存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="340" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ivfpq" value="IVF+PQ ⭐&#xa;倒排+量化，最常用组合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="400" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sq" value="SQ 标量量化&#xa;简单快速，精度适中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="460" width="185" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_pq" edge="1" source="cat_quant" target="pq" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ivfpq" edge="1" source="cat_quant" target="ivfpq" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sq" edge="1" source="cat_quant" target="sq" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 图例 -->
        <mxCell id="legend_title" value="⭐ = 工业界首选" style="text;html=1;strokeColor=none;fillColor=#fffde7;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="250" height="35" as="geometry"/>
        </mxCell>

        <!-- 底部维度诅咒说明 -->
        <mxCell id="curse" value="⚠️ 维度诅咒：树类算法在高维（>20维）空间退化严重，高维场景首选图索引或量化方案" style="text;html=1;strokeColor=#e74c3c;fillColor=#fadbd8;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="570" width="1000" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========== 图2: HNSW 分层图结构 ========== -->
  <diagram name="02-HNSW分层结构">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="t" value="HNSW 分层导航图结构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1000" height="45" as="geometry"/>
