        <mxCell id="idx3" value="C₃ → [v7, v10, v12, v13, ...]  ← 候选簇②" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e67e22;strokeColor=#ca6f1e;fontColor=#ffffff;fontSize=12;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="335" width="440" height="50" as="geometry"/>
        </mxCell>

        <!-- 搜索步骤说明 -->
        <mxCell id="steps" value="① 计算Q与所有簇中心{C₁,C₂,C₃}的距离&#xa;② 选择最近的nprobe个簇（图中C₂,C₃）&#xa;③ 仅在候选簇的向量列表内做精确搜索&#xa;④ 返回Top-K结果&#xa;&#xa;⚡ 搜索量：从 N 缩减到 N/K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfefe;strokeColor=#1a1a2e;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="405" width="440" height="115" as="geometry"/>
