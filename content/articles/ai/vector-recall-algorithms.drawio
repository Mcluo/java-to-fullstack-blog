  <!-- ========== 图4: 乘积量化 PQ ========== -->
  <diagram name="04-乘积量化PQ">
    <mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="PQ 乘积量化原理（以128维向量为例）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1000" height="45" as="geometry"/>
        </mxCell>

        <!-- 原始向量 -->
        <mxCell id="orig_label" value="原始向量 (128维, float32 = 512 bytes)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#e74c3c;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="orig" value="[0.12, 0.87, 0.34, 0.56, 0.91, 0.23, ... (128个float32)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1100" height="50" as="geometry"/>
        </mxCell>

        <!-- 切分箭头 -->
        <mxCell id="split_label" value="Step1: 切分成M个子向量（M=8，每段16维）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#2980b9;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="arrow_down1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2980b9;strokeWidth=2;" edge="1" source="orig" target="subvec_row" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 子向量行 -->
        <mxCell id="subvec_row" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="230" width="1100" height="1" as="geometry"/>
        </mxCell>

        <!-- 子向量1-8 -->
        <mxCell id="sv1" value="子向量1&#xa;dims 1-16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv2" value="子向量2&#xa;dims 17-32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="185" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv3" value="子向量3&#xa;dims 33-48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv4" value="子向量4&#xa;dims 49-64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#8e44ad;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv5" value="子向量5&#xa;dims 65-80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f39c12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv6" value="子向量6&#xa;dims 81-96" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f8f5;strokeColor=#1abc9c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="725" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv7" value="子向量7&#xa;dims 97-112" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdedec;strokeColor=#e74c3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="120" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sv8" value="子向量8&#xa;dims 113-128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#2ecc71;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="995" y="240" width="120" height="65" as="geometry"/>
        </mxCell>

        <!-- Step2: 码本 -->
        <mxCell id="codebook_label" value="Step2: 每段子向量独立训练码本（256个聚类中心）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#8e44ad;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="1100" height="30" as="geometry"/>
        </mxCell>

        <!-- 码本示意 -->
        <mxCell id="cb1" value="码本₁&#xa;256个中心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2980b9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="375" width="120" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cb2" value="码本₂&#xa;256个中心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="185" y="375" width="120" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="dots" value="···" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="450" y="385" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="cb8" value="码本₈&#xa;256个中心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#2ecc71;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="995" y="375" width="120" height="55" as="geometry"/>
        </mxCell>

        <!-- 量化结果 -->
        <mxCell id="step3_label" value="Step3: 每个子向量量化为1个编码（uint8，1 byte）→ 整个向量压缩为8 bytes" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#e67e22;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="1100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="code" value="编码结果: [42, 17, 253, 8, 199, 66, 31, 147]    (8 bytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="495" width="800" height="55" as="geometry"/>
        </mxCell>

        <!-- 压缩比对比 -->
        <mxCell id="compare_box" value="💾 内存对比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#1a1a2e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="200" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="orig_size" value="原始: 128维 × 4 bytes = 512 bytes/向量&#xa;1亿向量 → 51.2 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pq_size" value="PQ压缩: 8 bytes/向量（M=8）&#xa;1亿向量 → 0.8 GB  （压缩比 64:1 🎉）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="640" width="550" height="60" as="geometry"/>
        </mxCell>

        <!-- 连接箭头 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2980b9;" edge="1" source="sv1" target="cb1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;" edge="1" source="sv2" target="cb2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2ecc71;" edge="1" source="sv8" target="cb8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========== 图5: 混合召回流程 ========== -->
  <diagram name="05-混合召回RAG流程">
    <mxGraphModel dx="1100" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="RAG 混合召回系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1000" height="45" as="geometry"/>
        </mxCell>

        <!-- 用户查询 -->
        <mxCell id="user_q" value="用户查询&#xa;「什么是向量数据库？」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#1a1a2e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="75" width="280" height="65" as="geometry"/>
        </mxCell>

        <!-- 并行召回分支 -->
        <mxCell id="parallel_label" value="并行召回" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=3;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- BM25 分支 -->
        <mxCell id="bm25_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0ff;strokeColor=#8e44ad;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="205" width="440" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="bm25_title" value="🔍 BM25 关键词召回通道" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#8e44ad;" vertex="1" parent="1">
          <mxGeometry x="80" y="215" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="tokenize" value="分词 + 词频统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="200" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="invert_idx" value="倒排索引查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="bm25_result" value="BM25 Top-100&#xa;[doc_id, bm25_score]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e44ad;strokeColor=#7d3c98;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="360" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="bt1" edge="1" source="tokenize" target="invert_idx" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bt2" edge="1" source="invert_idx" target="bm25_result" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- HNSW 分支 -->
        <mxCell id="hnsw_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#e74c3c;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="205" width="440" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="hnsw_title" value="🧠 HNSW 向量语义召回通道" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#e74c3c;" vertex="1" parent="1">
          <mxGeometry x="720" y="215" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="embed" value="Embedding 模型&#xa;(qwen3-embedding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="260" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="hnsw_idx" value="HNSW索引查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#e74c3c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="265" width="150" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="hnsw_result" value="向量 Top-100&#xa;[doc_id, similarity]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e74c3c;strokeColor=#c0392b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="360" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ht1" edge="1" source="embed" target="hnsw_idx" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ht2" edge="1" source="hnsw_idx" target="hnsw_result" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 从用户查询到两个分支 -->
        <mxCell id="q_to_bm25" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8e44ad;strokeWidth=2;" edge="1" source="user_q" target="tokenize" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q_to_hnsw" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e74c3c;strokeWidth=2;" edge="1" source="user_q" target="embed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- RRF 融合 -->
        <mxCell id="rrf" value="RRF 融合排序&#xa;(Reciprocal Rank Fusion)&#xa;score = Σ 1/(k + rank_i)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f39c12;strokeColor=#d68910;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="500" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bm25_to_rrf" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8e44ad;strokeWidth=2;" edge="1" source="bm25_result" target="rrf" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hnsw_to_rrf" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e74c3c;strokeWidth=2;" edge="1" source="hnsw_result" target="rrf" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 过滤 -->
        <mxCell id="filter" value="元数据过滤&#xa;(类别/时间/权限)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27ae60;strokeColor=#1e8449;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="625" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rrf_to_filter" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f39c12;strokeWidth=2;" edge="1" source="rrf" target="filter" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 最终结果 -->
        <mxCell id="final" value="🎯 Top-K 召回结果 → LLM 生成答案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#1a1a2e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="715" width="440" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="filter_to_final" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;strokeWidth=2;" edge="1" source="filter" target="final" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 说明框 -->
        <mxCell id="why_hybrid" value="为什么混合？&#xa;BM25: 精确词匹配（向量数据库→找到含'向量数据库'的文档）&#xa;HNSW: 语义理解（faiss, milvus, pinecone等同义文档也能召回）&#xa;两者互补 = 更高召回率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f39c12;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="350" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

