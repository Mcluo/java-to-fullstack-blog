        <mxCell id="qb" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e74c3c;strokeWidth=2;dashed=1;" edge="1" source="query" target="idx3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- nprobe 参数说明 -->
        <mxCell id="nprobe" value="nprobe 参数：越大精度越高，越小速度越快" style="text;html=1;strokeColor=#e74c3c;fillColor=#fadbd8;align=center;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="570" width="600" height="35" as="geometry"/>
