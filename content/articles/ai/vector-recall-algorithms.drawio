          <mxGeometry x="40" y="235" width="1120" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="l1label" value="Layer 1（中等密度）— 区域内导航" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#27ae60;" vertex="1" parent="1">
