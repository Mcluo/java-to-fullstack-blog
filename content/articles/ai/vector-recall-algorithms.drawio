          <mxGeometry x="110" y="90" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="entry_arrow" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2980b9;" edge="1" source="entry_label" target="l2n1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 搜索路径箭头 (红色虚线) -->
        <mxCell id="path1" value="搜索路径" style="text;html=1;strokeColor=#e74c3c;fillColor=#fadbd8;align=center;fontSize=11;fontColor=#e74c3c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="590" width="160" height="30" as="geometry"/>
        </mxCell>

        <!-- 目标标注 -->
        <mxCell id="target_label" value="🎯 查询最近邻" style="text;html=1;strokeColor=#e74c3c;fillColor=none;align=center;fontSize=12;fontColor=#e74c3c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="630" width="180" height="30" as="geometry"/>
        </mxCell>

        <!-- 搜索过程说明 -->
        <mxCell id="step_box" value="搜索过程:&#xa;① 从Layer 2入口点A出发，跳到最近节点E&#xa;② 下降到Layer 1，在E周围继续贪心搜索&#xa;③ 下降到Layer 0，精确找到目标节点E★&#xa;④ 复杂度: O(log N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfefe;strokeColor=#1a1a2e;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="430" height="120" as="geometry"/>
        </mxCell>

        <!-- 层之间的虚线连接(表示同一节点跨层) -->
        <mxCell id="cross1" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l2n1" target="l1n1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cross2" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l2n2" target="l1n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cross3" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l2n3" target="l1n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cross4" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l1n1" target="l0n1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cross5" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l1n3" target="l0n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cross6" style="endArrow=none;strokeColor=#95a5a6;strokeWidth=1;dashed=1;" edge="1" source="l1n6" target="l0n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

