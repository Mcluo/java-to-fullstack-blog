        </mxCell>
        <mxCell id="l2label" value="Layer 2（最稀疏）— 长距离跳跃，快速定位大致范围" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#2980b9;" vertex="1" parent="1">
