          </mxGeometry>
        </mxCell>

        <mxCell id="270" value="问题：双向依赖导致 Bean 间强耦合&#xa;• 任意 Bean 可互相调用，难以追踪数据来源&#xa;• 循环依赖风险（A依赖B，B又依赖A）&#xa;• 单元测试需要 Mock 整个 Spring 容器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#FF6B6B;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="595" width="580" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="271" value="双向注入 = 任意 Bean 可互相调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#C62828;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="690" width="350" height="35" as="geometry"/>
        </mxCell>

        <!-- RIGHT: React -->
        <mxCell id="300" value="React 组件树 — 单向数据流 (Unidirectional Data Flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#388E3C;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="660" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="301" value="组件树 (Component Tree)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#50C878;fontSize=12;fontStyle=2;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="660" height="430" as="geometry"/>
