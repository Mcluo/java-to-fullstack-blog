        <mxCell id="380" value="优势：单向数据流让状态变化可预测&#xa;• 数据流向清晰，从上往下，用 DevTools 一目了然&#xa;• 组件解耦，可独立测试，不依赖全局 Context&#xa;• setState 触发重渲染，副作用可控" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#50C878;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="595" width="660" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="381" value="单向流 = Props向下传递，Callback向上通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#388E3C;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="690" width="400" height="35" as="geometry"/>
