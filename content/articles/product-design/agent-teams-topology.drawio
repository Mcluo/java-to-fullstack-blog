<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram name="Agent Teams 拓扑与生命周期">
    <mxGraphModel width="1100" height="680" dx="0" dy="0" grid="0" gridSize="10" guides="0" tooltips="1" connect="0" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1100" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Background -->
        <mxCell id="2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#CCCCCC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1060" height="640" as="geometry"/>
        </mxCell>

        <!-- Title -->
        <mxCell id="3" value="Claude Code Agent Teams：拓扑结构与生命周期" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="1060" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== LEFT: TOPOLOGY ===== -->
        <mxCell id="4" value="拓扑结构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="480" height="30" as="geometry"/>
        </mxCell>

        <!-- Leader node -->
        <mxCell id="10" value="Leader（你）&#xa;Team Lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="130" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- Agent A: Frontend -->
        <mxCell id="11" value="Agent A&#xa;前端开发 (Frontend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#3A9B5A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Agent B: Backend -->
        <mxCell id="12" value="Agent B&#xa;后端开发 (Backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;strokeColor=#7D3C9A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="270" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Agent C: Testing -->
        <mxCell id="13" value="Agent C&#xa;测试工程师 (Testing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- TaskList shared -->
        <mxCell id="14" value="共享任务列表 TaskList&#xa;~/.claude/tasks/{team-name}/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#C8A800;fontColor=#5A4A00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="410" width="300" height="55" as="geometry"/>
        </mxCell>

        <!-- Leader → Agents -->
        <mxCell id="20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A90D9;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="258" y="190" as="sourcePoint"/>
            <mxPoint x="140" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A90D9;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="285" y="190" as="sourcePoint"/>
            <mxPoint x="290" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4A90D9;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="312" y="190" as="sourcePoint"/>
            <mxPoint x="440" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Agents → TaskList -->
        <mxCell id="23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#888888;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="325" as="sourcePoint"/>
            <mxPoint x="210" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#888888;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="325" as="sourcePoint"/>
            <mxPoint x="290" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#888888;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="325" as="sourcePoint"/>
            <mxPoint x="370" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- SendMessage arrows between agents (A→B, B→C) -->
        <mxCell id="26" value="SendMessage" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#E74C3C;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="195" y="286" width="80" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="27" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="297" as="sourcePoint"/>
            <mxPoint x="210" y="297" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- A ↔ B arrow -->
        <mxCell id="28" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;startArrow=open;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="297" as="sourcePoint"/>
            <mxPoint x="210" y="297" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- SendMessage label A to B -->
        <mxCell id="29" value="消息传递" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#E74C3C;" vertex="1" parent="1">
          <mxGeometry x="194" y="280" width="70" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="290" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;startArrow=open;startFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="295" as="sourcePoint"/>
            <mxPoint x="210" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Simple horizontal arrow A→B -->
        <mxCell id="291" value="SendMessage" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;align=center;fontSize=9;fontColor=#E74C3C;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="290" as="sourcePoint"/>
            <mxPoint x="210" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- A→B  -->
        <mxCell id="30a" value="SendMessage" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=center;fontSize=9;fontColor=#E74C3C;" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- B→C  -->
        <mxCell id="30b" value="SendMessage" style="endArrow=open;endFill=0;html=1;strokeColor=#E74C3C;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=center;fontSize=9;fontColor=#E74C3C;" edge="1" source="12" target="13" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Team config file note -->
        <mxCell id="31" value="~/.claude/teams/{name}/config.json" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#7F8C8D;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="480" width="300" height="16" as="geometry"/>
        </mxCell>

        <!-- ===== RIGHT: LIFECYCLE ===== -->
        <mxCell id="5" value="生命周期" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="460" height="30" as="geometry"/>
        </mxCell>

        <!-- Lifecycle steps -->
        <mxCell id="40" value="Step 1: TeamCreate&#xa;创建团队 + 任务目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="115" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="Step 2: TaskCreate&#xa;拆分任务并设置依赖关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="195" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="Step 3: Agent 派生&#xa;指定类型 general-purpose / Explore / Plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#3A9B5A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="275" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="Step 4: 任务分配&#xa;自动认领 或 手动 TaskUpdate(owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#3A9B5A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="355" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="Step 5: 监控 + 沟通&#xa;TaskList() 查看进度 / SendMessage 协调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#C8A800;fontColor=#5A4A00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="435" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="45" value="Step 6: 优雅关闭&#xa;shutdown_request → TeamDelete()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="515" width="360" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows between lifecycle steps -->
        <mxCell id="50" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="165" as="sourcePoint"/>
            <mxPoint x="810" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="51" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="245" as="sourcePoint"/>
            <mxPoint x="810" y="275" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="325" as="sourcePoint"/>
            <mxPoint x="810" y="355" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="53" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="405" as="sourcePoint"/>
            <mxPoint x="810" y="435" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="54" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="485" as="sourcePoint"/>
            <mxPoint x="810" y="515" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Idle note -->
        <mxCell id="60" value="⚠️ Agent 空闲（idle）是正常状态！&#xa;可随时 SendMessage 唤醒继续工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#AAAAAA;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="630" y="590" width="360" height="45" as="geometry"/>
        </mxCell>

        <!-- Divider -->
        <mxCell id="70" value="" style="endArrow=none;html=1;strokeColor=#CCCCCC;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="565" y="80" as="sourcePoint"/>
            <mxPoint x="565" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Agent type legend bottom left -->
        <mxCell id="80" value="Agent 类型选择原则" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#2C3E50;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="81" value="● general-purpose：编码、编辑、读写" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#50C878;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="280" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="82" value="● Explore：只能搜索和读取" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#FF6B6B;" vertex="1" parent="1">
          <mxGeometry x="40" y="566" width="240" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="83" value="● Plan：只能规划，不能编辑文件" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#FF6B6B;" vertex="1" parent="1">
          <mxGeometry x="40" y="587" width="250" height="18" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="90" value="Team = TaskList（1:1 对应）| 所有 Agent 共享同一任务池" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=3;fontColor=#7F8C8D;" vertex="1" parent="1">
          <mxGeometry x="20" y="632" width="1060" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
