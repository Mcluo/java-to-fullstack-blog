        <mxCell id="97" value="流结束信号" style="resizable=0;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;" connectable="0" vertex="1" parent="96">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- Cleanup -->
        <mxCell id="98" value="AbortController.abort()&#xa;关闭连接，停止轮询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#FF6B6B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="700" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="99" value="" style="endArrow=open;endFill=0;strokeColor=#FF6B6B;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="680" as="sourcePoint"/>
            <mxPoint x="355" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Show completed to user -->
        <mxCell id="101" value="" style="endArrow=open;endFill=0;strokeColor=#2C3E50;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="745" as="sourcePoint"/>
            <mxPoint x="110" y="745" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="102" value="报告渲染完成，展示给用户" style="resizable=0;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;" connectable="0" vertex="1" parent="101">
