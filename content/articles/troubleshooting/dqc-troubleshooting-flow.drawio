<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
  <diagram name="DQC排查流程">
    <mxGraphModel dx="1100" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="DQC 表行数波动异常排查方法论" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend_title" value="图例" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="50" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="legend_normal" value="正常路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#2E8B57;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend_anomaly" value="异常路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend_action" value="分析动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="190" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend_decision" value="判断节点" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#B8860B;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="230" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== 主流程 ===== -->

        <!-- Step 0: DQC告警 -->
        <mxCell id="s0" value="🔴 DQC 红色告警&#xa;表行数波动 &gt; 阈值 1.3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="80" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 1: 读取告警详情 -->
        <mxCell id="s1" value="Step 1：读取告警详情&#xa;Chrome MCP 访问内网 DQC 页面&#xa;chrome_navigate → chrome_get_web_content&#xa;获取：规则名称、采样值、业务日期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="arr01" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s0" target="s1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 2: 宏观趋势分析 -->
        <mxCell id="s2" value="Step 2：宏观趋势分析&#xa;SQL: GROUP BY ds + COUNT(1)&#xa;拉长时间窗口（近 3 周）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="360" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="arr12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 判断1: 单日还是持续？ -->
        <mxCell id="d1" value="是单日异常&#xa;还是持续波动？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#B8860B;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="450" width="210" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="arr2d1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 单日正常路径注释 -->
        <mxCell id="single_note" value="⚠️ 经验：拉长时间窗口再判断！&#xa;单日异常往往是系统性问题冰山一角" style="text;html=1;strokeColor=#FF6B6B;fillColor=#FFF0F0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#CC4444;" vertex="1" parent="1">
          <mxGeometry x="580" y="465" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- 持续波动 → 继续 -->
        <mxCell id="arr_d1_continue" value="持续波动" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontStyle=1;fontColor=#FF6B6B;" edge="1" source="d1" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 3: 分区完整性检查 -->
        <mxCell id="s3" value="Step 3：分区完整性检查&#xa;SHOW PARTITIONS table_name;&#xa;发现缺失分区 → 调度任务失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="590" width="360" height="70" as="geometry"/>
        </mxCell>

        <!-- 分区缺失 异常路径 -->
        <mxCell id="missing_partition" value="🔴 分区缺失&#xa;调度任务间歇性未运行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="595" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arr3_missing" value="有缺失" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontStyle=1;fontColor=#FF6B6B;" edge="1" source="s3" target="missing_partition" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr34" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 4: 表结构分析 -->
        <mxCell id="s4" value="Step 4：表结构分析&#xa;DESC table_name;&#xa;理解字段含义、业务语义&#xa;关注：LastDDLTime（DDL 变更记录）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="710" width="360" height="80" as="geometry"/>
        </mxCell>

        <!-- DDL变更 -->
        <mxCell id="ddl_note" value="🟡 DDL 变更线索&#xa;LastDDLTime → 可能影响上游写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=#B8860B;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="720" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arr4_ddl" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" source="s4" target="ddl_note" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr45" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s4" target="s5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 5: 多维度拆解（关键） -->
        <mxCell id="s5" value="⭐ Step 5：多维度拆解（关键转折点）&#xa;CASE WHEN type/country/platform 分组&#xa;定位：哪个维度是波动源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9B59B6;strokeColor=#6C3483;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="840" width="380" height="80" as="geometry"/>
        </mxCell>

        <!-- 正常维度 -->
        <mxCell id="normal_dim" value="🟢 正常维度&#xa;其他数据（Amazon/TikTok）&#xa;稳定在 600-960 条/天" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#50C878;strokeColor=#2E8B57;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="830" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- 异常维度 -->
        <mxCell id="anomaly_dim" value="🔴 异常维度&#xa;CN/taobao/keyword&#xa;从百万级骤降→几千" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="910" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="arr5_normal" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#50C878;" edge="1" source="s5" target="normal_dim" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr5_anomaly" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.7;entryX=0;entryY=0.5;strokeColor=#FF6B6B;" edge="1" source="s5" target="anomaly_dim" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr56" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s5" target="s6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 6: 数据质量校验 -->
        <mxCell id="s6" value="Step 6：数据质量校验&#xa;COUNT DISTINCT(key) → 去重检查&#xa;NULL 率跨分区对比 → 向量计算稳定性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#2C6FA8;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="970" width="380" height="70" as="geometry"/>
        </mxCell>

        <!-- 空值率异常 -->
        <mxCell id="null_rate" value="🔴 embedding 空值率 3-20%&#xa;向量计算服务可能限流或异常" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B6B;strokeColor=#CC4444;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="978" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="arr6_null" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#FF6B6B;" edge="1" source="s6" target="null_rate" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr67" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s6" target="conclusion" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 结论 -->
        <mxCell id="conclusion" value="Step 7：形成结论&#xa;单日告警 → 系统性链路问题（持续 2 周+）&#xa;根因：CN/taobao 关键词向量化链路不稳定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#111111;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="1090" width="400" height="75" as="geometry"/>
        </mxCell>

        <!-- 核心经验箱 -->
        <mxCell id="key_insight" value="💡 核心经验&#xa;不要被单日告警限制视野&#xa;拉长时间窗口 + 多维度拆解&#xa;才能看到真正的问题模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#D4AC0D;fontColor=#8B6914;fontSize=13;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="1095" width="210" height="75" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
