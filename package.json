{
  "name": "java-to-fullstack-blog",
  "version": "0.1.0",
  "description": "A blog platform to help Java engineers transition to full-stack + AI development",
  "private": true,
  "scripts": {
    "predev": "rm -rf .next/cache && (bun run scripts/build-embeddings.ts || true)",
    "dev": "next dev",
    "prebuild": "if [ -z \"$VERCEL\" ]; then bun run scripts/build-embeddings.ts; fi",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-notes": "npx tsx scripts/sync-notes.ts",
    "build:embeddings": "bun run scripts/build-embeddings.ts",
    "watch:articles": "bun run scripts/watch-articles.ts",
    "fetch:feeds": "npx tsx scripts/fetch-feeds.ts",
    "smoke-test": "bun run scripts/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@langchain/core": "^1.1.39",
    "@langchain/textsplitters": "^1.0.1",
    "@supabase/supabase-js": "^2.43.0",
    "@types/xml2js": "^0.4.14",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "langchain": "^1.3.1",
    "lucide-react": "^0.395.0",
    "mermaid": "^11.14.0",
    "next": "^14.2.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "fast-xml-parser": "^5.5.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": "20.x"
  }
}
